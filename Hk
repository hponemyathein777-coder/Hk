<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khan Job Calculator</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #121212;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .calculator-card {
            width: 100%;
            max-width: 420px;
            background-color: #1e1e1e;
            border-radius: 16px;
            padding: 24px;
            border: 2px solid #fbc02d;
            box-shadow: 0 8px 24px rgba(251, 192, 45, 0.15);
        }

        .header {
            text-align: center;
            margin-bottom: 24px;
        }

        .title {
            font-size: 22px;
            font-weight: bold;
            color: #fbc02d;
        }

        .input-group {
            margin-bottom: 16px;
        }

        .input-group label {
            display: block;
            font-weight: 600;
            color: #e0e0e0;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .input-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #333;
            border-radius: 8px;
            font-size: 16px;
            background-color: #2a2a2a;
            color: #fff;
            outline: none;
            transition: border-color 0.2s;
        }

        .input-group input:focus {
            border-color: #fbc02d;
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background-color: #fbc02d;
            color: #000;
            font-size: 16px;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.2s;
        }

        .btn-submit:hover {
            background-color: #fdd835;
        }

        .result-box {
            margin-top: 24px;
            padding: 16px;
            background-color: #2a2a2a;
            border-radius: 8px;
            border-left: 4px solid #fbc02d;
        }

        .result-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 15px;
        }

        .result-item:last-child {
            margin-bottom: 0;
            font-weight: bold;
            color: #fbc02d;
        }
    </style>
</head>
<body>

    <div class="calculator-card">
        <div class="header">
            <h2 class="title">Khan Job Calculator</h2>
        </div>

        <div class="input-group">
            <label>Height</label>
            <input type="number" id="height" placeholder="0">
        </div>

        <div class="input-group">
            <label>Hollow</label>
            <input type="number" id="hollow" placeholder="0">
        </div>

        <div class="input-group">
            <label>Long Gap</label>
            <input type="number" id="longGap" placeholder="0">
        </div>

        <div class="input-group">
            <label>Short Gap</label>
            <input type="number" id="shortGap" placeholder="0">
        </div>

        <button class="btn-submit" onclick="calculate()">Calculate</button>

        <div class="result-box">
            <div class="result-item">
                <span>Remaining Space:</span>
                <span id="remainingSpace">0</span>
            </div>
            <div class="result-item">
                <span>Gap Result:</span>
                <span id="gapResult">0</span>
            </div>
        </div>
    </div>

    <script>
        function calculate() {
            const height = parseFloat(document.getElementById('height').value) || 0;
            const hollow = parseFloat(document.getElementById('hollow').value) || 0;
            const longGap = parseFloat(document.getElementById('longGap').value) || 0;
            const shortGap = parseFloat(document.getElementById('shortGap').value) || 0;

            const remainingSpace = height - hollow;
            const gapResult = remainingSpace > 0 ? (remainingSpace / 2) : 0;

            document.getElementById('remainingSpace').innerText = remainingSpace;
            document.getElementById('gapResult').innerText = gapResult;
        }
    </script>

</body>
</html>
